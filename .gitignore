# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*

# pnpm
.pnpm-store/

# yarn (not used)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# lockfiles — only pnpm-lock.yaml is tracked
package-lock.json
yarn.lock

# next.js
/.next/
/out/

# production
/build

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CMS (removed — not used)
cms/

# Verification scripts (temporary)
verify-*.js
test-*.js
check-*.js
fix-*.js
*-SUMMARY.md

# Development files
.vscode/
.idea/
.claude/
dev-docs/*
!dev-docs/.gitkeep
/*.md
/*.js
!next.config.js
!postcss.config.js
!tailwind.config.js
/*.ps1
/todo
/*.code-workspace
.kiro/
temp-backup/
